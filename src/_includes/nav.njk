</header>
<style>
.nav-div{width:1px;height:15px;background:rgba(200,168,102,.5);align-self:center;flex:0 0 auto}
.brand-mark{height:30px;width:auto;display:block}
/* The wordmark is an image, so her name would otherwise exist only in alt
   text: not selectable, skipped by page translation, weighted less by search.
   This span carries the real text; the image is alt="" + aria-hidden so
   screen readers announce the name once, not twice. */
.brand-name-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
/* Tagline is sized to track the wordmark, which is a very wide 9.44:1 script.
   Tracking stays in em so it scales with font-size; text-indent cancels the
   trailing letter-space so the line stays optically centred. The C swash
   reaches further left than the script's right terminal, so the mark's optical
   centre sits ~1.6% of its width left of its bounding-box centre; translateX
   in em compensates and scales with the mark. */
.brand-tag{font-size:.58rem;letter-spacing:.44em;text-indent:.44em;transform:translateX(-.48em)}
/* The header shrinks on scroll. Scaling the whole lockup once keeps the rose,
   wordmark and tagline in proportion and runs on the compositor; animating each
   element's height/font-size instead forced a reflow every frame, and the rose
   had no transition at all, so it snapped while the rest eased. */
header.nav.scrolled .brand{transform:scale(.9)}
@media (max-width:1100px){.brand-mark{height:26px}.brand-tag{font-size:.50rem}}
@media (max-width:900px){.brand-mark{height:24px}.brand-tag{font-size:.46rem}}
@media (max-width:420px){.brand-mark{height:20px}.brand-tag{font-size:.40rem;letter-spacing:.34em;text-indent:.34em}}
/* Crest crowning the slide-in mobile menu; desktop nav is a horizontal row,
   so it is hidden there. Decorative — the brand link already carries her name.
   The panel is viewport-height with justify-content:center, so anything added
   here eats headroom: on shorter phones the crest shrinks, and on the shortest
   it steps aside entirely rather than pushing links off-screen. */
.menu-crest,.menu-crest-link{display:none}
@media (max-width:900px){
  /* the crest links home; these must outrank nav.links a (0,1,1) and
     nav.links a::after, hence the fuller selector */
  nav.links a.menu-crest-link{display:block;margin:0 auto 4px;padding:0;line-height:0;font-size:0}
  nav.links a.menu-crest-link::after{display:none}
  nav.links a.menu-crest-link:focus-visible{outline:1px solid var(--gilt);outline-offset:5px}
  .menu-crest{display:block;width:190px;height:auto;opacity:.92;transition:opacity .3s}
  nav.links a.menu-crest-link:hover .menu-crest{opacity:1}
}
@media (max-width:900px) and (max-height:700px){.menu-crest{width:108px}nav.links{gap:15px}}
@media (max-width:900px) and (max-height:520px){nav.links a.menu-crest-link{display:none}nav.links{gap:12px}}
.links a.nav-cta{border:1px solid var(--gilt-deep);border-radius:2px;padding:7px 17px;color:var(--gilt-soft)}
.links a.nav-cta::after{display:none}
.links a.nav-cta:hover{background:var(--gilt);border-color:var(--gilt);color:var(--ink)}
.links a.nav-cta.is-current{background:var(--gilt-deep);border-color:var(--gilt-deep);color:var(--ink)}
@media (max-width:900px){.nav-div{display:none}.links a.nav-cta{padding:9px 26px;margin-top:6px}}
</style>
