{%- if pg.head.banner %}
<section class="pagehead pagehead-banner"><img class="phb-img" src="{{ pg.head.banner }}" alt="{{ pg.head.banner_alt }}"{% if pg.head.banner_position %} style="object-position:{{ pg.head.banner_position }}"{% endif %} />
  <div class="wrap reveal"><div class="phb-text">
    <div class="kick">{{ pg.head.kick | safe }}</div><h1>{{ pg.head.title | safe }}</h1>
    <p>{{ pg.head.intro | safe }}</p>
  </div></div>
</section>
<style>.pagehead-banner{position:relative;min-height:min(92vh,860px);padding:0;display:flex;align-items:flex-end;overflow:hidden;background:var(--ink)}.phb-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 45%}.pagehead-banner::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(25,13,16,.55) 0%,rgba(25,13,16,0) 22%,rgba(25,13,16,0) 50%,rgba(25,13,16,.92) 100%),linear-gradient(90deg,rgba(25,13,16,.82) 0%,rgba(25,13,16,.45) 30%,rgba(25,13,16,0) 46%)}.pagehead-banner .wrap{position:relative;z-index:2;width:100%;padding-bottom:64px}.phb-text{max-width:430px}.pagehead-banner h1{font-size:clamp(2.6rem,5vw,3.9rem)}.pagehead-banner p{font-size:1rem}@media(min-width:821px){.pagehead-banner .wrap{max-width:none;padding-left:clamp(24px,6vw,110px)}}.pagehead-banner p{color:rgba(243,237,225,.82)}@media(max-width:820px){.pagehead-banner{min-height:640px}.phb-img{object-position:center 40%}}</style>
{%- elif pg.head.photo %}
{%- set hd = pg.head.photo | imgDims %}
<section class="pagehead pagehead-split"><div class="wrap reveal">
  <div class="ph-grid">
    <div class="ph-text">
      <div class="kick">{{ pg.head.kick | safe }}</div><h1>{{ pg.head.title | safe }}</h1>
      <p>{{ pg.head.intro | safe }}</p>
    </div>
    <div class="ph-photo">
      <img src="{{ pg.head.photo }}" alt="{{ pg.head.photo_alt }}"{% if hd %} width="{{ hd.w }}" height="{{ hd.h }}"{% endif %} />
      {%- if pg.head.photo_caption %}<div class="cap-inline">{{ pg.head.photo_caption | safe }}</div>{% endif %}
    </div>
  </div>
</div></section>
{%- else %}
<section class="pagehead"><div class="wrap reveal">
  <div class="kick">{{ pg.head.kick | safe }}</div><h1>{{ pg.head.title | safe }}</h1>
  <p>{{ pg.head.intro | safe }}</p>
</div></section>
{%- endif %}
{%- for b in pg.sections %}
{%- if b.type == "band" %}
<div class="band{% if b.tall %} band-tall{% endif %} reveal"><img src="{{ b.image | replace("XNONEX", "XNONEX") }}" alt="{{ b.alt }}"{% if b.position %} style="object-position:{{ b.position }}"{% endif %}  loading="lazy" />
{%- if b.quote %}
  <div class="wrap"><div class="cap"><div class="q">{{ b.quote | safe }}</div><div class="src">{{ b.source | safe }}</div></div></div>
{%- endif %}
</div>
{%- elif b.type == "text" %}
<section class="paper sec"><div class="wrap">
  {%- if b.label %}
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  {%- endif %}
  <div class="bodytext reveal">
    {%- for p in b.paragraphs %}
    <p>{{ p.text | safe }}</p>
    {%- endfor %}
  </div>
</div></section>
{%- elif b.type == "text_photo" %}
<section class="paper sec"><div class="wrap">
  <div class="two">
    {%- if b.image_side == "left" %}
    <figure class="portrait-card reveal" style="margin:0"><img src="{{ b.image | replace("XNONEX", "XNONEX") }}" alt="{{ b.alt }}"  loading="lazy" /></figure>
    {%- endif %}
    <div class="bodytext reveal">
      {%- for p in b.paragraphs %}
      <p>{{ p.text | safe }}</p>
      {%- endfor %}
      {%- if b.offers and b.offers.length %}
      <div class="offer" style="grid-template-columns:1fr;margin-top:30px">
        {%- for o in b.offers %}
        <div class="o"><h4>{{ o.heading | safe }}</h4><p>{{ o.text | safe }}</p></div>
        {%- endfor %}
      </div>
      {%- endif %}
      {%- if b.cta_label %}
      <div class="cta-row reveal"><a class="btn btn-gilt" href="{{ b.cta_link }}">{{ b.cta_label | safe }}</a></div>
      {%- endif %}
    </div>
    {%- if b.image_side != "left" %}
    <figure class="portrait-card reveal" style="margin:0"><img src="{{ b.image | replace("XNONEX", "XNONEX") }}" alt="{{ b.alt }}"  loading="lazy" /></figure>
    {%- endif %}
  </div>
</div></section>
{%- elif b.type == "text_appointments" %}
<section class="paper sec"><div class="wrap">
  <div class="two">
    <div class="bodytext reveal">
      {%- for p in b.paragraphs %}
      <p>{{ p.text | safe }}</p>
      {%- endfor %}
    </div>
    <div class="reveal">{% for po in b.posts %}<div class="post"><div><div class="p-role">{{ po.role | safe }}</div><div class="p-place">{{ po.place | safe }}</div></div><div class="p-loc">{{ po.location | safe }}</div></div>{% endfor %}</div>
  </div>
  {%- if b.photo %}
  {%- set ad = b.photo | imgDims %}
  <figure class="portrait-card section-photo reveal"><img style="height:auto" src="{{ b.photo }}" alt="{{ b.photo_alt }}"{% if ad %} width="{{ ad.w }}" height="{{ ad.h }}"{% endif %} loading="lazy" />{% if b.photo_caption %}<div class="cap">{{ b.photo_caption | safe }}</div>{% endif %}</figure>
  {%- endif %}
</div></section>
{%- elif b.type == "text_studio" %}
<section class="paper sec"><div class="wrap">
  <div class="two">
    <div class="bodytext reveal">
      {%- for p in b.paragraphs %}
      <p>{{ p.text | safe }}</p>
      {%- endfor %}
      {%- if b.photo %}
      {%- set sd = b.photo | imgDims %}
      <figure class="portrait-card studio-photo reveal" style="margin:30px 0 0"><img style="height:auto" src="{{ b.photo }}" alt="{{ b.photo_alt }}"{% if sd %} width="{{ sd.w }}" height="{{ sd.h }}"{% endif %} loading="lazy" />{% if b.photo_caption %}<div class="cap">{{ b.photo_caption | safe }}</div>{% endif %}</figure>
      {%- endif %}
    </div>
    <div class="studio reveal">
      <div class="movement" style="margin-bottom:14px"><span class="lbl">{{ b.studio_label | safe }}</span></div>
      <h3>{{ b.studio_heading | safe }}</h3>
      <p>{{ b.studio_text | safe }}</p>
      <div class="instr-grid">{% for i in b.instruments %}<div class="instr-card{% if loop.first %} instr-lead{% endif %}"><img src="{{ i.icon | replace("XNONEX", "XNONEX") }}" alt="{{ i.label }}"  loading="lazy" /><span>{{ i.label | safe }}</span></div>{% endfor %}</div>
      <a class="btn btn-gilt" href="{{ b.cta_link }}">{{ b.cta_label | safe }}</a>
    </div>
  </div>
</div></section>
{%- elif b.type == "scholarship" %}
<section class="diss"><div class="wrap">
  <div class="euch reveal">
    <img class="euch-monstrance" src="/assets/img/monstrance.svg" alt="" aria-hidden="true"  loading="lazy" />
    <blockquote class="euch-q">{{ b.latin | safe }}<span>{{ b.translation | safe }}</span></blockquote>
    {% if b.text %}<p class="euch-sub">{{ b.text | safe }}</p>{% endif %}
  </div>
  <div class="diss-card reveal">
  <div class="movement center"><span class="lbl">{{ b.label | safe }}</span></div>
  <div class="deg">{{ b.degree | safe }}</div>
  <h2>{{ b.title | safe }}</h2>{% if b.title_sub %}<p class="diss-tsub">{{ b.title_sub | safe }}</p>{% endif %}
  <p class="sub">{{ b.subtitle | safe }}</p>
  <div class="meta">{% for m in b.meta %}<span>{{ m.role | safe }} &nbsp;<b>{{ m.name | safe }}</b></span>{% endfor %}</div>
</div></div></section>
{%- elif b.type == "endorsements" %}
<section class="endorse" id="endorsements"><div class="wrap">
  <div class="movement center reveal"><span class="lbl">{{ b.label | default("From Those Who Know Her") | safe }}</span></div>
  <div class="en-grid">
{%- for e in endorsements.items %}{% if e.quote %}
    <div class="en-card{% if e.wide %} en-wide{% endif %} reveal"><div class="en-q">&ldquo;{{ e.quote | safe }}&rdquo;</div>
    <div class="en-meta"><div class="en-name">{{ e.name }}</div><div class="en-role">{{ e.role | roleBreak | safe }}</div></div></div>
{%- endif %}{%- endfor %}
  </div>
</div></section>
{%- elif b.type == "patrons" %}
<section class="patron-sec reveal"><div class="wrap">
  <img class="patron-orn" src="/assets/img/rose-mark.svg" alt="" aria-hidden="true"  loading="lazy" />
  <div class="patron-label">{{ b.label | safe }}</div>
  <div class="patrons">
    {%- for p in b.patrons %}
    <div class="patron">
      <figure class="patron-fig"><img src="{{ p.image | replace("XNONEX", "XNONEX") }}" alt="{{ p.alt }}"  loading="lazy" /></figure>
      <div class="patron-name">{{ p.name | safe }}</div>
      <div class="patron-desc">{{ p.description | safe }}</div>
      <blockquote class="patron-q">{{ p.latin | safe }}<span>{{ p.translation | safe }}</span></blockquote>
    </div>
    {%- endfor %}
  </div>
</div></section>
{%- elif b.type == "stage_work" %}
<section class="paper sec"><div class="wrap">
{%- if b.columns_first %}
  <div class="movement reveal"><span class="lbl">{{ b.label_top | safe }}</span><span class="rule"></span></div>
  <div class="listcols reveal">
    {%- for col in b.columns %}
    <div><h3>{{ col.heading | safe }}</h3>
      {%- for e in col.entries %}
      <div class="cs-entry">{% if e.tag %}<span class="tag">{{ e.tag | safe }}</span>{% endif %}<div class="t">{{ e.title | safe }}</div><div class="d">{{ e.detail | safe }}</div></div>
      {%- endfor %}
      {%- if col.photo %}<figure class="figcap recital-fig reveal"><img src="{{ col.photo }}" alt="{{ col.photo_alt }}"  loading="lazy" />{% if col.photo_caption %}<figcaption>{{ col.photo_caption | safe }}</figcaption>{% endif %}</figure>{% endif %}
    </div>
    {%- endfor %}
  </div>
  <div class="movement reveal" style="margin-top:72px"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  <div class="two">
    <div class="perf-stack reveal">{% for f in b.photos %}<figure class="figcap" style="margin:0"><img src="{{ f.image }}" alt="{{ f.alt }}"  loading="lazy" /><figcaption>{{ f.caption | safe }}</figcaption></figure>{% endfor %}</div>
    <div class="reveal"><table class="program">{% for r in b.roles %}<tr><td class="role">{{ r.role | safe }}</td><td class="work">{{ r.work | safe }}</td><td class="co">{{ r.company | safe }}</td></tr>{% endfor %}</table>
      <div class="scenes"><b>{{ b.scenes_heading | safe }}</b>{{ b.scenes_text | safe }}</div>
    </div>
  </div>
{%- else %}
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  <div class="two">
    <div class="perf-stack reveal">{% for f in b.photos %}<figure class="figcap" style="margin:0"><img src="{{ f.image }}" alt="{{ f.alt }}"  loading="lazy" /><figcaption>{{ f.caption | safe }}</figcaption></figure>{% endfor %}</div>
    <div class="reveal"><table class="program">{% for r in b.roles %}<tr><td class="role">{{ r.role | safe }}</td><td class="work">{{ r.work | safe }}</td><td class="co">{{ r.company | safe }}</td></tr>{% endfor %}</table>
      <div class="scenes"><b>{{ b.scenes_heading | safe }}</b>{{ b.scenes_text | safe }}</div>
    </div>
  </div>
  <div class="listcols reveal">
    {%- for col in b.columns %}
    <div><h3>{{ col.heading | safe }}</h3>
      {%- for e in col.entries %}
      <div class="cs-entry">{% if e.tag %}<span class="tag">{{ e.tag | safe }}</span>{% endif %}<div class="t">{{ e.title | safe }}</div><div class="d">{{ e.detail | safe }}</div></div>
      {%- endfor %}
      {%- if col.photo %}<figure class="figcap recital-fig reveal"><img src="{{ col.photo }}" alt="{{ col.photo_alt }}"  loading="lazy" />{% if col.photo_caption %}<figcaption>{{ col.photo_caption | safe }}</figcaption>{% endif %}</figure>{% endif %}
    </div>
    {%- endfor %}
  </div>
{%- endif %}
</div></section>
{%- elif b.type == "recordings" %}
<section class="recordings sec" style="background:var(--ink-2);border-top:1px solid var(--rule-d)"><div class="wrap">
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  <p class="rec-intro reveal">{{ b.intro | safe }}</p>
  <div class="rel-list">
    {%- for r in b.releases %}
    <article class="rel-card reveal">
      <img class="rel-cover" src="{{ r.cover | replace("XNONEX", "XNONEX") }}" alt="{{ r.cover_alt }}" loading="lazy" />
      <div class="rel-body">
        <div class="rel-tag">{{ r.tag | safe }}</div>
        <h3 class="rel-title">{{ r.title | safe }}</h3>
        <div class="rel-credit">{{ r.credit | safe }}</div>
        <div class="rel-role">{{ r.role | safe }}</div>
        <div class="rel-note">{{ r.note | safe }}</div>
        <div class="rel-links">
          {%- for l in r.links %}
          <a class="rel-btn" href="{{ l.url }}" target="_blank" rel="noopener noreferrer">{{ l.label | safe }}</a>
          {%- endfor %}
        </div>
      </div>
    </article>
    {%- endfor %}
  </div>
</div></section>
{%- elif b.type == "quote_card" %}
<section class="sec qc-sec"><div class="wrap"><figure class="qc{% if not b.second %} qc-one{% endif %} reveal">
  <div class="qc-main"><span class="qc-lbl">{{ b.label | safe }}</span>
  <blockquote>&ldquo;{{ b.quote | safe }}&rdquo;</blockquote></div>
  <div class="qc-side">
  {%- if b.second %}<p class="qc-second">{{ b.second | safe }}</p>{% endif %}
  <figcaption>{{ b.cite | safe }}</figcaption>
  {%- if b.note %}<p class="qc-note">{{ b.note | safe }}</p>{% endif %}
  {%- if b.link %}<a class="qc-link" href="{{ b.link }}" target="_blank" rel="noopener noreferrer">{{ b.link_label | default("Read more") }} &rarr;</a>{% endif %}
  </div>
</figure></div></section>
<style>.qc-sec{padding:24px 0 56px}.qc{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1.6fr 1fr;gap:44px;align-items:center;padding:38px 44px;}.qc.qc-one{max-width:880px;grid-template-columns:1fr;gap:0;text-align:center;padding:36px 48px}.qc.qc-one .qc-side{border:0;padding:0;margin-top:16px;display:flex;justify-content:center;align-items:baseline;gap:22px;flex-wrap:wrap}.qc.qc-one figcaption,.qc.qc-one .qc-link{margin-top:0}.qc{border:1px solid rgba(200,168,102,.45);box-shadow:inset 0 0 0 7px var(--ink,#190d10),inset 0 0 0 8px rgba(200,168,102,.22);background:radial-gradient(600px 300px at 30% 0%,rgba(200,168,102,.07),transparent 70%)}.qc-lbl{display:block;font-weight:600;font-size:.7rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gilt);margin-bottom:14px}.qc blockquote{margin:0;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:clamp(1.25rem,1.9vw,1.6rem);line-height:1.38;color:var(--parchment)}.qc-side{border-left:1px solid rgba(200,168,102,.3);padding-left:36px}.qc-second{margin:0;font-family:"Cormorant Garamond",serif;font-size:1.15rem;line-height:1.4;color:var(--gilt-soft,#d9bf86)}.qc figcaption{margin-top:14px;font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-2)}.qc-note{color:var(--muted);margin:10px 0 0}.qc-link{display:inline-block;margin-top:16px;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gilt);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}@media(max-width:820px){.qc{grid-template-columns:1fr;gap:22px;padding:30px 24px}.qc-side{border-left:0;padding-left:0;border-top:1px solid rgba(200,168,102,.3);padding-top:20px}}</style>
{%- elif b.type == "ensembles" %}
{%- set shown = b.items %}
{%- if shown.length %}
<section class="sec ens-sec"><div class="wrap">
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  {%- if b.intro %}<p class="ens-intro reveal">{{ b.intro | safe }}</p>{% endif %}
  <div class="ens-grid">{% for e in shown %}<div class="ens reveal{% if not e.text %} ens-soon{% endif %}"><h3>{{ e.name | safe }}</h3><p>{% if e.text %}{{ e.text | safe }}{% else %}Details coming soon.{% endif %}</p></div>{% endfor %}</div>
  {%- if b.note %}<p class="ens-note reveal">{{ b.note | safe }}</p>{% endif %}
</div></section>
{%- endif %}
{%- elif b.type == "faq" %}
{%- set shown = b.items %}
{%- if shown.length %}
<section class="sec faq-sec paper"><div class="wrap">
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  {%- if b.intro %}<p class="ens-intro reveal">{{ b.intro | safe }}</p>{% endif %}
  <div class="faq reveal">{% for e in shown %}<details{% if loop.first %} open{% endif %}{% if not e.a %} class="faq-soon"{% endif %}><summary>{{ e.q | safe }}</summary><p>{% if e.a %}{{ e.a | safe }}{% else %}<em>An answer is coming soon. In the meantime, Christa is glad to answer this directly. <a href="/contact/">Ask her</a>.</em>{% endif %}</p></details>{% endfor %}</div>
</div></section>
{%- endif %}
{%- elif b.type == "selected" %}
{%- set featured = [] %}{%- for sb in pg.sections %}{% if sb.type == "videos" %}{% for v in sb.videos %}{% if v.featured %}{% set featured = (featured.push(v), featured) %}{% endif %}{% endfor %}{% endif %}{% endfor %}
<section id="selected" class="sec sel-sec"><div class="wrap">
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  {%- if b.intro %}<p class="sel-intro reveal">{{ b.intro | safe }}</p>{% endif %}
  <div class="vgrid sel-grid">
    {%- for v in featured %}
    {%- include "vcard.njk" %}
    {%- endfor %}
  </div>
  <p class="sel-more reveal"><a href="#watch">All recordings, interviews, and features &darr;</a></p>
</div></section>
{%- elif b.type == "videos" %}
<section id="watch" class="sec paper"><div class="wrap">
  <div class="movement reveal"><span class="lbl">{{ b.label | safe }}</span><span class="rule"></span></div>
  {%- if b.feature_embed %}
  <div class="feature-film">
    <div class="vframe reveal"><iframe src="{{ b.feature_embed }}" title="{{ b.feature_title }}" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>
    <div class="film-meta reveal"><div class="tag">{{ b.feature_tag | safe }}</div><h3>{{ b.feature_title | safe }}</h3>
      <p>{{ b.feature_text | safe }}</p>
      <a class="btn btn-ghost" href="{{ b.feature_button_url }}" target="_blank" rel="noopener noreferrer">{{ b.feature_button_label | safe }}</a></div>
  </div>
  {%- endif %}
  {%- if b.more_label %}<div class="movement reveal" style="margin-top:8px"><span class="lbl">{{ b.more_label | safe }}</span><span class="rule"></span></div>{% endif %}
  <div class="vgrid">
    {%- for v in b.videos %}{% if not v.featured %}
    {%- include "vcard.njk" %}
    {%- endif %}{% endfor %}
  </div>
  {%- if b.videos2 and b.videos2.length %}
<div class="movement reveal" style="margin-top:64px"><span class="lbl">{{ b.label2 | safe }}</span><span class="rule"></span></div>
  <div class="vgrid">
    {%- for v in b.videos2 %}
    {%- include "vcard.njk" %}
    {%- endfor %}
  </div>
  {%- endif %}
  <script>(function(){if(window.__vplay)return;window.__vplay=1;document.querySelectorAll(".vplay").forEach(function(b){b.addEventListener("click",function(){var id=b.getAttribute("data-yt"),f=b.closest(".vframe");if(!f)return;f.innerHTML='<iframe src="https://www.youtube.com/embed/'+id+'?rel=0&autoplay=1&enablejsapi=1" title="Christa Dalmazio" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>';});});})();</script>
</div></section>
{%- elif b.type == "affiliations" %}
<section class="sec" style="background:var(--ink-2);border-top:1px solid var(--rule-d)"><div class="wrap">
  <div class="movement center reveal"><span class="lbl">{{ b.label | safe }}</span></div>
  <div class="logowall reveal">
    <div class="lw-side lw-left">
      {%- for l in b.left %}
      {%- if l.url %}<a class="lg{% if l.extra_class %} {{ l.extra_class }}{% endif %}" href="{{ l.url }}" target="_blank" rel="noopener noreferrer"><img src="{{ l.image | replace("XNONEX", "XNONEX") }}" alt="{{ l.alt }}"  loading="lazy" /></a>{% else %}<span class="lg{% if l.extra_class %} {{ l.extra_class }}{% endif %}"><img src="{{ l.image | replace("XNONEX", "XNONEX") }}" alt="{{ l.alt }}"  loading="lazy" /></span>{% endif %}
      {%- endfor %}
    </div>
    <span class="lg lg-feature lw-center"><span class="word word-lg">{{ b.center | safe }}</span></span>
    <div class="lw-side lw-right">
      {%- for l in b.right %}
      {%- if l.url %}<a class="lg{% if l.extra_class %} {{ l.extra_class }}{% endif %}" href="{{ l.url }}" target="_blank" rel="noopener noreferrer"><img src="{{ l.image | replace("XNONEX", "XNONEX") }}" alt="{{ l.alt }}"  loading="lazy" /></a>{% else %}<span class="lg{% if l.extra_class %} {{ l.extra_class }}{% endif %}"><img src="{{ l.image | replace("XNONEX", "XNONEX") }}" alt="{{ l.alt }}"  loading="lazy" /></span>{% endif %}
      {%- endfor %}
    </div>
  </div>
</div></section>
{%- endif %}
{%- endfor %}
